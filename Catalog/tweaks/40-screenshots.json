{
  "id": "screenshots",
  "title": { "en": "Screenshots", "es": "Capturas de pantalla" },
  "icon": "camera.viewfinder",
  "order": 40,
  "tweaks": [
    {
      "id": "screenshots.no-shadow",
      "title": { "en": "Window screenshots without shadow", "es": "Capturas de ventana sin sombra" },
      "description": { "en": "Window screenshots (⇧⌘4 then Space) are saved without the drop shadow.", "es": "Las capturas de una ventana (⇧⌘4 y espacio) se guardan sin el borde de sombra." },
      "tested": "27",
      "actions": [
        {
          "type": "defaults",
          "domain": "com.apple.screencapture",
          "key": "disable-shadow",
          "valueType": "bool",
          "value": true
        }
      ],
      "restart": [
        "SystemUIServer"
      ]
    },
    {
      "id": "screenshots.no-thumbnail",
      "title": { "en": "No floating thumbnail", "es": "Sin miniatura flotante" },
      "description": { "en": "Screenshots are saved instantly, without the corner thumbnail that delays them a few seconds.", "es": "La captura se guarda al instante, sin la miniatura de la esquina que la retrasa unos segundos." },
      "tested": "27",
      "actions": [
        {
          "type": "defaults",
          "domain": "com.apple.screencapture",
          "key": "show-thumbnail",
          "valueType": "bool",
          "value": false
        }
      ],
      "restart": [
        "SystemUIServer"
      ]
    },
    {
      "id": "screenshots.jpg",
      "title": { "en": "Save as JPG", "es": "Guardar en JPG" },
      "description": { "en": "Much smaller files than PNG. Loses some quality on text and UI.", "es": "Archivos mucho más pequeños que PNG. Pierde algo de calidad en texto e interfaces." },
      "tested": "27",
      "risk": "medium",
      "actions": [
        {
          "type": "defaults",
          "domain": "com.apple.screencapture",
          "key": "type",
          "valueType": "string",
          "value": "jpg"
        }
      ],
      "restart": [
        "SystemUIServer"
      ]
    }
  ]
}
